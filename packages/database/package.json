{
  "name": "@atlas/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema, migrations, client and repositories (Drizzle ORM)",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "embedded": "tsx src/cli/embedded-server.ts"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-socket": "0.2.11",
    "drizzle-kit": "^0.31.11"
  }
}
