{
  "name": "atlas-os",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas OS — local-first personal intelligence and smart-room platform",
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @atlas/api dev",
    "dev:worker": "pnpm --filter @atlas/worker dev",
    "dev:web": "pnpm --filter @atlas/web dev",
    "db:embedded": "pnpm --filter @atlas/database embedded",
    "db:generate": "pnpm --filter @atlas/database generate",
    "db:migrate": "pnpm --filter @atlas/database migrate",
    "db:seed": "pnpm --filter @atlas/core seed",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:secrets",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
