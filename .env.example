# =========================
# ATLAS CORE
# =========================

NODE_ENV=development

ATLAS_BASE_URL=http://localhost:5173
ATLAS_API_URL=http://localhost:4000

ATLAS_ENCRYPTION_KEY=
SESSION_SECRET=


# =========================
# DATABASE
# =========================

POSTGRES_USER=atlas
POSTGRES_PASSWORD=
POSTGRES_DB=atlas

DATABASE_URL=postgresql://atlas:YOUR_PASSWORD@localhost:5432/atlas


# =========================
# HOME ASSISTANT
# =========================

HOME_ASSISTANT_URL=
HOME_ASSISTANT_ACCESS_TOKEN=


# =========================
# GOOGLE
# =========================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback


# =========================
# VERCEL API
# =========================

VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_IDS=


# =========================
# AI / MIMO
# =========================

AI_GATEWAY_API_KEY=

ATLAS_AI_FAST_MODEL=xiaomi/mimo-v2.6-flash
ATLAS_AI_REASONING_MODEL=xiaomi/mimo-v2.6-pro


# =========================
# AUDIO TRANSCRIPTION
# =========================

TRANSCRIPTION_PROVIDER=vercel-ai-gateway
